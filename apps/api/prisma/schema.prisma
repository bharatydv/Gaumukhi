// Divyaloka — data model
// All money is stored as INTEGER PAISE. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── enums ───────────────────────────

enum Role {
  CUSTOMER
  PANDIT
  SUPPORT
  CATALOGUE
  PUJA_COORDINATOR
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
  REFERRAL
}

enum BookingMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum BookingStatus {
  PENDING_PAYMENT
  AWAITING_PANDIT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum SlotStatus {
  OPEN
  HELD
  BOOKED
  BLOCKED
}

enum PanditStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertKind {
  AUTHENTICITY
  LAB_REPORT
  XRAY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// ─────────────────────────── identity ───────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?
  googleId     String?   @unique
  name         String?
  role         Role      @default(CUSTOMER)
  points       Int       @default(0)
  referralCode String    @unique
  referredById String?
  referredBy   User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]    @relation("Referrals")
  blocked      Boolean   @default(false)
  emailVerified Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]
  bookings     Booking[]
  reviews      Review[]
  cart         Cart?
  wishlist     WishlistItem[]
  tickets      Ticket[]
  pandit       Pandit?
  pointsLedger PointsEntry[]
  sessions     RefreshToken[]
  notifications Notification[]

  @@index([role])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  family     String
  revoked    Boolean  @default(false)
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, family])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders    Order[]
  bookings  Booking[]

  @@index([userId])
}

// ─────────────────────────── catalog ───────────────────────────

model Category {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  groupName    String
  description  String?
  bannerKey    String?
  imageKey     String?
  displayOrder Int        @default(0)
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  active       Boolean    @default(true)
  seo          Seo?

  products     Product[]

  @@index([displayOrder])
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  sku         String        @unique
  name        String
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  description String
  benefits    Json          @default("[]")
  howToWear   String?
  careNotes   String?
  mrp         Int
  price       Int
  gstRate     Decimal       @default(3.0) @db.Decimal(4, 2)
  hsnCode     String?
  barcode     String?
  mukhi       Int?
  origin      String?
  material    String?
  weightGrams Int?
  dimensions  String?
  artKind     String        @default("bead") // renderer hint: mala|bracelet|pendant|bead|cloth|yantra|idol|incense|samagri|book|gift
  artTone     String        @default("rudraksha")
  badge       String?
  status      ProductStatus @default(ACTIVE)
  featured    Boolean       @default(false)
  ratingAvg   Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount Int           @default(0)
  soldCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants     Variant[]
  media        Media[]
  certificates Certificate[]
  reviews      Review[]
  seo          Seo?
  orderItems   OrderItem[]
  wishlisted   WishlistItem[]
  cartItems    CartItem[]

  @@index([categoryId, status])
  @@index([price])
  @@index([featured, status])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  label      String // "8 mm / 108 beads"
  size       String?
  priceDelta Int         @default(0)
  isDefault  Boolean     @default(false)

  inventory  Inventory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Warehouse {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  city      String
  pincode   String
  inventory Inventory[]
}

model Inventory {
  id           String    @id @default(cuid())
  variantId    String
  variant      Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  onHand       Int       @default(0)
  reserved     Int       @default(0)
  reorderPoint Int       @default(6)
  updatedAt    DateTime  @updatedAt

  @@unique([variantId, warehouseId])
}

model Media {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String   @default("image") // image | video | spin360
  key       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Certificate {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      CertKind
  number    String   @unique
  issuer    String
  fileKey   String?
  issuedAt  DateTime @default(now())

  @@index([productId])
}

model Seo {
  id              String    @id @default(cuid())
  productId       String?   @unique
  product         Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId      String?   @unique
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  postId          String?   @unique
  post            Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title           String
  metaDescription String
  keywords        String?
  ogImageKey      String?
  canonicalUrl    String?
  noIndex         Boolean   @default(false)
}

// ─────────────────────────── commerce ───────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  giftWrap  Boolean    @default(false)
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
  items     CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  qty       Int      @default(1)
  addedAt   DateTime @default(now())

  @@unique([cartId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Int // percent (1-100) or paise
  maxDiscount  Int?
  minCart      Int?
  usageLimit   Int?
  usedCount    Int        @default(0)
  perUserLimit Int        @default(1)
  appliesToPuja Boolean   @default(false)
  startsAt     DateTime   @default(now())
  expiresAt    DateTime?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  carts    Cart[]
  orders   Order[]
  bookings Booking[]
  usages   CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  @@index([couponId, userId])
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  addressId     String
  address       Address       @relation(fields: [addressId], references: [id])
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  subtotal      Int
  discount      Int           @default(0)
  giftWrapFee   Int           @default(0)
  shippingFee   Int           @default(0)
  tax           Int           @default(0)
  total         Int
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  pointsUsed    Int           @default(0)
  notes         String?
  placedAt      DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]
  shipment Shipment?
  refunds  Refund[]
  invoice  Invoice?

  @@index([userId, placedAt])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id])
  nameSnapshot String
  skuSnapshot  String
  unitPrice   Int
  qty         Int
  gstRate     Decimal  @db.Decimal(4, 2)
  lineTotal   Int

  @@index([orderId])
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  fileKey   String?
  issuedAt  DateTime @default(now())
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier      String    @default("Shiprocket")
  awb          String?
  labelKey     String?
  trackingUrl  String?
  status       String    @default("CREATED")
  shippedAt    DateTime?
  deliveredAt  DateTime?
  events       Json      @default("[]")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  provider       String // razorpay | stripe
  providerOrderId String?
  providerPaymentId String?    @unique
  method         String?
  amount         Int
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  rawPayload     Json?
  createdAt      DateTime      @default(now())

  @@index([orderId])
  @@index([bookingId])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String
  payload    Json
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model Refund {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Int
  reason    String
  status    PaymentStatus @default(PENDING)
  approvedBy String?
  createdAt DateTime      @default(now())

  @@index([orderId])
}

model PointsEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────── puja ───────────────────────────

model Puja {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String
  durationMin  Int
  baseFee      Int
  samagriFee   Int       @default(0)
  panditCount  Int       @default(1)
  imageKey     String?
  active       Boolean   @default(true)
  displayOrder Int       @default(0)

  bookings Booking[]
  offered  PanditService[]
}

model Pandit {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  city          String
  state         String       @default("Uttar Pradesh")
  experienceYrs Int
  veda          String
  languages     String[]
  bio           String?
  dakshina      Int
  commissionPct Decimal      @default(12.0) @db.Decimal(4, 2)
  status        PanditStatus @default(PENDING)
  ratingAvg     Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount   Int          @default(0)
  bankLast4     String?
  createdAt     DateTime     @default(now())

  certificates PanditCertificate[]
  availability Availability[]
  services     PanditService[]
  bookings     Booking[]
  payouts      Payout[]

  @@index([city, status])
}

model PanditCertificate {
  id         String    @id @default(cuid())
  panditId   String
  pandit     Pandit    @relation(fields: [panditId], references: [id], onDelete: Cascade)
  title      String
  issuer     String
  fileKey    String?
  verifiedAt DateTime?
}

model PanditService {
  id       String @id @default(cuid())
  panditId String
  pandit   Pandit @relation(fields: [panditId], references: [id], onDelete: Cascade)
  pujaId   String
  puja     Puja   @relation(fields: [pujaId], references: [id], onDelete: Cascade)

  @@unique([panditId, pujaId])
}

model Availability {
  id        String     @id @default(cuid())
  panditId  String
  pandit    Pandit     @relation(fields: [panditId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  slot      String // "06:30"
  status    SlotStatus @default(OPEN)
  heldUntil DateTime?
  bookingId String?
  updatedAt DateTime   @updatedAt

  @@unique([panditId, date, slot])
  @@index([date, status])
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  pujaId        String
  puja          Puja          @relation(fields: [pujaId], references: [id])
  panditId      String?
  pandit        Pandit?       @relation(fields: [panditId], references: [id])
  mode          BookingMode
  scheduledAt   DateTime
  slot          String
  language      String        @default("Hindi")
  addressId     String?
  address       Address?      @relation(fields: [addressId], references: [id])
  sankalpNotes  String?
  attachments   Json          @default("[]")
  vidhiFee      Int
  dakshina      Int           @default(0)
  samagriFee    Int           @default(0)
  discount      Int           @default(0)
  total         Int
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  status        BookingStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  meetingUrl    String?
  recordingKey  String?
  receiptKey    String?
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]
  reviews  Review[]

  @@index([panditId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  panditId    String
  pandit      Pandit       @relation(fields: [panditId], references: [id], onDelete: Cascade)
  amount      Int
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutStatus @default(PENDING)
  utr         String?
  createdAt   DateTime     @default(now())

  @@index([panditId, createdAt])
}

// ─────────────────────────── content & ops ───────────────────────────

model Review {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  verified  Boolean          @default(false)
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([productId, status])
}

model Question {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  body      String
  answer    String?
  answeredBy String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, published])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  categoryName String   @default("Journal")
  coverKey    String?
  authorName  String
  readMinutes Int       @default(5)
  published   Boolean   @default(false)
  publishedAt DateTime?
  seo         Seo?
  createdAt   DateTime  @default(now())

  @@index([published, publishedAt])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model Banner {
  id           String    @id @default(cuid())
  placement    String // hero | festival | category
  headline     String
  subheadline  String?
  ctaLabel     String?
  ctaHref      String?
  imageKey     String?
  displayOrder Int       @default(0)
  active       Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
}

model HomeSection {
  id           String  @id @default(cuid())
  key          String  @unique
  label        String
  displayOrder Int
  visible      Boolean @default(true)
  config       Json    @default("{}")
}

model Ticket {
  id        String   @id @default(cuid())
  number    String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  body      String
  status    String   @default("OPEN")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String // email | sms | whatsapp | push | inapp
  template  String
  payload   Json
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
